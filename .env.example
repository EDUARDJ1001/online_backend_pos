# ------------------------------------------------------------------
# Configuración del backend. Copia este archivo como `.env` en la raíz
# del proyecto (o en apps/backend/.env) y completa los valores.
# El .env real NUNCA se sube al repositorio (está en .gitignore).
# ------------------------------------------------------------------

# --- Servidor ---
HOST=0.0.0.0
PORT=4000
NODE_ENV=production
# Dirección con la que se abren las pantallas (la IP de la PC servidor en la red).
FRONTEND_URL=http://localhost:3000
# Orígenes permitidos, separados por coma (agrega http://IP-DEL-SERVIDOR:3000 para otras PCs).
FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Detrás de un proxy (nginx, balanceador): cuántos saltos confiar para leer la IP del cliente. 0 = sin proxy.
TRUST_PROXY=0

# --- Base de datos ---
# mssql = SQL Server / Azure SQL (puerto 1433) | mysql = MySQL / MariaDB (puerto 3306)
DB_CLIENT=mssql
# Servidor: localhost, una IP, un nombre de la nube o una instancia con nombre (EQUIPO\SQLEXPRESS).
DB_HOST=localhost
DB_PORT=1433
# Usa un usuario propio para el sistema (no "sa" ni "root").
DB_USER=facturacion_app
DB_PASSWORD=
DB_NAME=facturacion
# REQUIRED para bases en la nube que exigen conexión cifrada.
DB_SSL_MODE=DISABLED
# Solo MySQL con SSL: ruta del certificado CA del proveedor (p. ej. ca.pem en la raíz).
DB_SSL_CA_PATH=
# true = al iniciar, prepara una base vacía y aplica las actualizaciones pendientes.
DB_AUTO_MIGRATE=false

# --- Sesiones ---
# Claves secretas distintas, largas y aleatorias (mínimo 16 caracteres). Sin ellas el sistema no arranca.
# Para generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si se cambian, todos los usuarios deben volver a iniciar sesión.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Impresora de tickets en el servidor (opcional) ---
# Normalmente cada caja imprime con el agente de impresión y esto queda vacío.
# USB compartida en Windows: windows:NombreCompartido | Red: tcp://IP:9100 | Serial: \\.\COM3
PRINTER_INTERFACE=
PRINTER_TYPE=EPSON
# Caracteres por línea: 48 (papel de 80 mm) o 32 (papel de 58 mm).
PRINTER_WIDTH=48
# Interlineado del ticket en puntos (menos = menos papel). 0 = el de la impresora.
PRINTER_LINE_SPACING=26
PRINTER_CHARACTER_SET=PC852_LATIN2
PRINTER_TIMEOUT=5000
# Solo impresoras seriales.
PRINTER_BAUD_RATE=9600
PRINTER_REMOVE_ACCENTS=false
PRINTER_LOGO=true
PRINTER_LOGO_WIDTH=320
PRINTER_LOGO_MAX_HEIGHT=140
PRINTER_LOGO_THRESHOLD=180
PRINTER_LOGO_INVERT=auto
PRINTER_LOGO_DITHER=true

# --- Versión de escritorio (normalmente no se usan) ---
# FACTURACION_ENV_FILE=   ruta de otro archivo de configuración (va en el entorno, no aquí)
# FRONTEND_DIST=          carpeta con las pantallas exportadas que sirve el backend
# MIGRATIONS_DIR=         carpeta de migraciones distinta a la del proyecto
